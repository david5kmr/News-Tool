# --- Anthropic -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Modelle (Defaults siehe mi/config.py, hier nur ueberschreiben wenn noetig)
# MI_MODEL_PREFILTER=claude-haiku-4-5
# MI_MODEL_DIGEST=claude-sonnet-5
# MI_MODEL_MONTHLY=claude-sonnet-5
# MI_MODEL_ASK=claude-opus-5

# --- Versand ---------------------------------------------------------------
# Backend: resend | smtp | console  (console = nur stdout, fuer Trockenlauf)
MI_MAIL_BACKEND=console
MI_MAIL_FROM=marktbrief@example.com
MI_MAIL_TO=du@example.com

# Resend
RESEND_API_KEY=re_...

# SMTP (Alternative zu Resend)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# --- Sonstiges -------------------------------------------------------------
MI_DB_PATH=data/mi.db
# Digest zeigt alles ab diesem Score (Spec: 4). Nach Bauschritt 3 kalibrieren.
MI_DIGEST_MIN_SCORE=4
MI_ALERT_MIN_SCORE=8
MI_MAX_ALERTS_PER_DAY=3
